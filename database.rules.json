{
  "rules": {
    ".read": false,
    ".write": false,
    "flotta": {
      ".read": "auth != null",
      ".indexOn": [
        "t"
      ],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['n', 'lat', 'lng', 't'])",
        "n": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
        },
        "b": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "lat": {
          ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
        },
        "lng": {
          ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
        },
        "c": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 360"
        },
        "v": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 100"
        },
        "t": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "punti": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$pid": {
          ".validate": "newData.hasChildren(['id', 'u']) && newData.child('id').val() === $pid",
          "id": {
            ".validate": "newData.isString() && newData.val().length <= 30"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "cat": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "note": {
            ".validate": "newData.isString() && newData.val().length <= 500"
          },
          "lat": {
            ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
          },
          "lng": {
            ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
          },
          "t": {
            ".validate": "newData.isNumber()"
          },
          "u": {
            ".validate": "newData.isNumber()"
          },
          "del": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "moderatori": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "relitti_nomi": {
      ".read": true,
      "$k": {
        ".write": "auth != null && root.child('moderatori').child(auth.uid).val() === true",
        ".validate": "newData.hasChildren(['n'])",
        "n": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
        },
        "da": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "t": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "nomi_privati": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$k": {
          ".validate": "newData.hasChildren(['n'])",
          "n": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
          },
          "s": {
            ".validate": "newData.isBoolean()"
          },
          "t": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "proposte": {
      ".read": "auth != null && root.child('moderatori').child(auth.uid).val() === true",
      "$k": {
        ".write": "auth != null && root.child('moderatori').child(auth.uid).val() === true",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['n', 'id', 't'])",
          "n": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
          },
          "id": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "u": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "lat": {
            ".validate": "newData.isNumber()"
          },
          "lng": {
            ".validate": "newData.isNumber()"
          },
          "t": {
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "recensioni": {
      ".read": true,
      "$k": {
        "$uid": {
          ".write": "auth != null && (auth.uid === $uid || root.child('moderatori').child(auth.uid).val() === true)",
          ".validate": "newData.hasChildren(['s', 't'])",
          "s": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5"
          },
          "txt": {
            ".validate": "newData.isString() && newData.val().length <= 500"
          },
          "n": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "t": {
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "pro": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "relitti_proposti": {
      ".read": "auth != null && root.child('moderatori').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === $uid || root.child('moderatori').child(auth.uid).val() === true)",
        "$k": {
          ".validate": "newData.hasChildren(['tipo', 'lat', 'lng', 't'])",
          "tipo": {
            ".validate": "newData.val() === 'nuovo' || newData.val() === 'posizione'"
          },
          "lat": {
            ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
          },
          "lng": {
            ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
          },
          "id": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "n": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "prof": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
          },
          "note": {
            ".validate": "newData.isString() && newData.val().length <= 500"
          },
          "anon": {
            ".validate": "newData.isBoolean()"
          },
          "u": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "t": {
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "relitti_utenti": {
      ".read": true,
      "$k": {
        ".write": "auth != null && root.child('moderatori').child(auth.uid).val() === true",
        ".validate": "newData.hasChildren(['lat', 'lng'])",
        "lat": {
          ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
        },
        "lng": {
          ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
        },
        "n": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "prof": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
        },
        "note": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "da": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "t": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "relitti_posizioni": {
      ".read": true,
      "$k": {
        ".write": "auth != null && root.child('moderatori').child(auth.uid).val() === true",
        ".validate": "newData.hasChildren(['lat', 'lng', 'id'])",
        "id": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "lat": {
          ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
        },
        "lng": {
          ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
        },
        "da": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "t": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}